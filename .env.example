# ==============================================================================
# STUDY RADAR ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the application.
# ==============================================================================

# Application & Security
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-in-production-studyradar-secret-key-32chars
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=studyradar
DB_USER=studyradar
DB_PASSWORD=studyradar_password
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgres://studyradar:studyradar_password@postgres:5432/studyradar

# Redis & Celery Background Queue
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI Provider Configuration
# Supported providers: mock, openai, compatible, local
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE=https://api.openai.com/v1

# Notifications - Telegram
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifications - Email (SMTP)
EMAIL_NOTIFICATION_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=alerts@studyradar.local
ALERT_RECIPIENT_EMAIL=user@example.com

# Local mock notifications logger (writes alerts to local audit log for testing/dev)
NOTIFICATION_LOCAL_LOG_ENABLED=True

# Platform Thresholds & Filtering
FRESHNESS_WINDOW_DAYS=7
CONFIDENCE_THRESHOLD_DATE=0.70
CONFIDENCE_THRESHOLD_GEO=0.70
CONFIDENCE_THRESHOLD_CLASSIFICATION=0.70

# Default User Preference
DEFAULT_TIMEZONE=Africa/Lagos

# Crawler & Networking Safety
CRAWLER_USER_AGENT=StudyRadarBot/1.0 (+https://studyradar.local/bot; contact@studyradar.local)
CRAWLER_DEFAULT_TIMEOUT=15
CRAWLER_MAX_RETRIES=3
CRAWLER_RATE_LIMIT_RPS=1
SSRF_PROTECTION_ENABLED=True

# Frontend URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
